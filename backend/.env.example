# Conexión a la base. PostgreSQL (recomendado):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres. Cambiarla en cada entorno.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
